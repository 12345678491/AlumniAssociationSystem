<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 校友会管理系统</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-primary mb-3">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">🎓 校友会管理系统</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="切换导航">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">首页</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Index">校友活动</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Donations" asp-action="Index">捐赠专区</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="News" asp-action="Index">资讯动态</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Jobs" asp-action="Index">招聘信息</a></li>
                        @if (User.Identity!.IsAuthenticated)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Messages" asp-action="Index">消息中心</a></li>
                            if (User.IsInRole(nameof(UserRole.Admin)))
                            {
                                <li class="nav-item"><a class="nav-link text-warning fw-bold" asp-controller="Admin" asp-action="Dashboard">管理后台</a></li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity!.IsAuthenticated)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Profile">👤 @User.GetUserName()</a></li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link text-light">退出</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">登录</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">注册</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 校友会管理系统（基于.NET / ASP.NET Core） | 数据库：SQLite | 认证：Cookie + RBAC
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
