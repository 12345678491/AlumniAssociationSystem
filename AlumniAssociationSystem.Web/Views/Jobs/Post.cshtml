@model JobPosting
@{
    ViewData["Title"] = "发布职位";
}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white"><strong>➕ 发布职位（提交后需管理员审核）</strong></div>
            <div class="card-body p-4">
                <form asp-action="Post" method="post">
                    <div class="row">
                        <div class="col-md-6 mb-3"><label class="form-label">公司名称 *</label><input asp-for="CompanyName" class="form-control" /><span asp-validation-for="CompanyName" class="text-danger"></span></div>
                        <div class="col-md-6 mb-3"><label class="form-label">职位名称 *</label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div>
                        <div class="col-md-6 mb-3"><label class="form-label">薪资待遇</label><input asp-for="Salary" class="form-control" placeholder="如：15K-25K" /></div>
                        <div class="col-md-6 mb-3"><label class="form-label">工作地点</label><input asp-for="Location" class="form-control" /></div>
                        <div class="col-12 mb-3"><label class="form-label">岗位职责 *</label><textarea asp-for="Responsibilities" class="form-control" rows="4"></textarea><span asp-validation-for="Responsibilities" class="text-danger"></span></div>
                        <div class="col-12 mb-3"><label class="form-label">任职要求 *</label><textarea asp-for="Requirements" class="form-control" rows="4"></textarea><span asp-validation-for="Requirements" class="text-danger"></span></div>
                        <div class="col-12 mb-3"><label class="form-label">联系方式</label><input asp-for="Contact" class="form-control" placeholder="邮箱或电话" /></div>
                    </div>
                    <button type="submit" class="btn btn-primary">提交审核</button>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
