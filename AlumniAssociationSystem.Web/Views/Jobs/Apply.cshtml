@model AlumniAssociationSystem.Web.Controllers.JobApplyViewModel
@{
    ViewData["Title"] = "投递简历";
    var job = (JobPosting)ViewBag.Job;
}
<div class="row justify-content-center mt-3">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-white"><strong>📨 投递：@job.Title（@job.CompanyName）</strong></div>
            <div class="card-body p-4">
                <form asp-action="Apply" method="post">
                    <input type="hidden" name="id" value="@job.Id" />
                    <div class="mb-3">
                        <label class="form-label">简历摘要 / 附件链接 *</label>
                        <textarea asp-for="ResumeSummary" class="form-control" rows="5" placeholder="请简述您的教育经历、工作经历与技能特长；也可粘贴简历文件的网络链接"></textarea>
                        <span asp-validation-for="ResumeSummary" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">确认投递</button>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
