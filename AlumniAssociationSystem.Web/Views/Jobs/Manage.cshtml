@model List<JobPosting>
@{
    ViewData["Title"] = "招聘管理";
}
<h2>💼 招聘信息管理</h2>
<table class="table table-hover align-middle shadow-sm bg-white rounded">
    <thead class="table-light"><tr><th>职位</th><th>公司</th><th>发布人</th><th>状态</th><th>操作</th></tr></thead>
    <tbody>
        @foreach (var j in Model)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@j.Id">@j.Title</a></td>
                <td>@j.CompanyName</td>
                <td>@j.PostedBy?.Name</td>
                <td>
                    @switch (j.Status)
                    {
                        case JobStatus.Pending: <span class="badge bg-warning text-dark">待审核</span> break;
                        case JobStatus.Approved: <span class="badge bg-success">已上架</span> break;
                        case JobStatus.Rejected: <span class="badge bg-danger">已驳回</span> break;
                    }
                </td>
                <td>
                    @if (j.Status != JobStatus.Approved)
                    {
                        <form asp-action="Audit" method="post" class="d-inline"><input type="hidden" name="id" value="@j.Id" /><input type="hidden" name="status" value="Approved" /><button class="btn btn-sm btn-success">通过</button></form>
                        <form asp-action="Audit" method="post" class="d-inline"><input type="hidden" name="id" value="@j.Id" /><input type="hidden" name="status" value="Rejected" /><button class="btn btn-sm btn-outline-danger">驳回</button></form>
                    }
                    <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('确定删除？')"><input type="hidden" name="id" value="@j.Id" /><button class="btn btn-sm btn-danger">删除</button></form>
                </td>
            </tr>
        }
    </tbody>
</table>
