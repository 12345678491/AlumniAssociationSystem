@model Event
@{
    ViewData["Title"] = Model.Title;
    var joined = Model.Registrations.Count(r => r.Status == RegistrationStatus.Registered);
    var mine = (EventRegistration?)ViewBag.MyRegistration;
}
<div class="row justify-content-center">
    <div class="col-md-9">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h3>@Model.Title</h3>
                <hr />
                <p class="text-muted">
                    📍 地点：@Model.Location<br />
                    🕘 时间：@Model.StartTime.ToString("yyyy年MM月dd日 HH:mm") ~ @Model.EndTime.ToString("HH:mm")<br />
                    👥 人数上限：@Model.Capacity 人（已报名 @joined 人）<br />
                    ⏰ 报名截止：@Model.Deadline.ToString("yyyy-MM-dd HH:mm")
                </p>
                <div class="p-3 bg-light rounded">@Html.Raw(Model.Description.Replace("\n", "<br/>"))</div>
            </div>
            <div class="card-footer bg-white p-3">
                @if (User.Identity!.IsAuthenticated)
                {
                    if (mine != null && mine.Status == RegistrationStatus.Registered)
                    {
                        <span class="badge bg-success fs-6">✔ 已报名</span>
                        <form asp-action="Cancel" method="post" class="d-inline ms-2">
                            <input type="hidden" name="id" value="@mine.Id" />
                            <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('确定取消报名？')">取消报名</button>
                        </form>
                    }
                    else if (mine != null && mine.Status == RegistrationStatus.Cancelled)
                    {
                        <span class="text-muted">您已取消报名，可重新报名</span>
                        <form asp-action="Signup" method="post" class="d-inline ms-2">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="contactPhone" value="" />
                            <button type="submit" class="btn btn-primary btn-sm">重新报名</button>
                        </form>
                    }
                    else if (DateTime.Now <= Model.Deadline && joined < Model.Capacity)
                    {
                        <form asp-action="Signup" method="post" class="row g-2 align-items-end">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <div class="col-auto flex-grow-1">
                                <input name="contactPhone" class="form-control" placeholder="联系电话（选填）" />
                            </div>
                            <div class="col-auto">
                                <button type="submit" class="btn btn-primary">立即报名</button>
                            </div>
                        </form>
                    }
                    else if (DateTime.Now > Model.Deadline)
                    {
                        <span class="text-danger">报名已截止</span>
                    }
                    else
                    {
                        <span class="text-danger">报名人数已满</span>
                    }
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Events/Details/@Model.Id" class="btn btn-primary">登录后报名</a>
                }
            </div>
        </div>

        @if (User.IsInRole(nameof(UserRole.Admin)))
        {
            <div class="card shadow-sm mt-4">
                <div class="card-header bg-white"><strong>📋 报名名单（管理员可见，@joined 人）</strong></div>
                <table class="table table-sm mb-0">
                    <thead><tr><th>#</th><th>姓名</th><th>联系电话</th><th>状态</th><th>报名时间</th></tr></thead>
                    <tbody>
                        @foreach (var r in Model.Registrations.Where(r => r.Status != RegistrationStatus.Cancelled))
                        {
                            <tr>
                                <td>@r.Id</td>
                                <td>@r.User?.Name</td>
                                <td>@r.ContactPhone</td>
                                <td>@(r.Status == RegistrationStatus.CheckedIn ? "已签到" : "已报名")</td>
                                <td>@r.CreatedAt.ToString("MM-dd HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
