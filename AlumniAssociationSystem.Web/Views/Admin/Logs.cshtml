@model List<OperationLog>
@{
    ViewData["Title"] = "操作日志";
}
<h2>📜 操作日志与审计</h2>
<table class="table table-hover shadow-sm bg-white rounded">
    <thead class="table-light"><tr><th>#</th><th>时间</th><th>操作人</th><th>操作类型</th><th>详情</th><th>IP</th></tr></thead>
    <tbody>
        @foreach (var l in Model)
        {
            <tr>
                <td>@l.Id</td>
                <td class="text-muted">@l.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>@l.OperatorName</td>
                <td><span class="badge bg-secondary">@l.Action</span></td>
                <td>@l.Detail</td>
                <td class="text-muted">@l.Ip</td>
            </tr>
        }
        @if (!Model.Any()) { <tr><td colspan="6" class="text-muted">暂无日志</td></tr> }
    </tbody>
</table>
