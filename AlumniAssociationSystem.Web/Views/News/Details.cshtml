@model NewsArticle
@{
    ViewData["Title"] = Model.Title;
}
<div class="row justify-content-center">
    <div class="col-md-9">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h3>@Model.Title</h3>
                <p class="text-muted small">
                    <span class="badge bg-primary">@(Model.Category == NewsCategory.Notice ? "通知公告" : "校友动态")</span>
                    @Model.Author?.Name · @Model.PublishTime?.ToString("yyyy-MM-dd HH:mm") · 👀 @Model.ViewCount 阅读
                </p>
                <hr />
                <div class="fs-5 lh-lg">@Html.Raw(Model.Content.Replace("\n", "<br/>"))</div>
            </div>
            @if (User.Identity!.IsAuthenticated)
            {
                <div class="card-footer bg-white p-3">
                    <form asp-action="Like" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button class="btn btn-outline-danger">👍 点赞 (@Model.LikeCount)</button>
                    </form>
                    <span class="text-muted small ms-2">（评论/分享功能为预留扩展点）</span>
                </div>
            }
        </div>
    </div>
</div>
