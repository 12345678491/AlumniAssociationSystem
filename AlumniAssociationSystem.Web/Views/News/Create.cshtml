@model NewsArticle
@{
    ViewData["Title"] = "发布资讯";
}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white"><strong>➕ 发布资讯（管理员直接发布）</strong></div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div class="mb-3"><label class="form-label">标题 *</label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div>
                    <div class="mb-3">
                        <label class="form-label">分类 *</label>
                        <select asp-for="Category" class="form-select">
                            <option value="@NewsCategory.Notice">通知公告</option>
                            <option value="@NewsCategory.Dynamic">校友动态/风采</option>
                        </select>
                    </div>
                    <div class="mb-3"><label class="form-label">正文 *</label><textarea asp-for="Content" class="form-control" rows="8"></textarea><span asp-validation-for="Content" class="text-danger"></span></div>
                    <button type="submit" class="btn btn-primary">发布</button>
                    <a class="btn btn-outline-secondary" asp-action="Manage">返回</a>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
