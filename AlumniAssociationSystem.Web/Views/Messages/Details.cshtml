@model Message
@{
    ViewData["Title"] = Model.Title;
}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h4>@Model.Title</h4>
                <p class="text-muted small">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</p>
                <hr />
                <p class="lh-lg">@Html.Raw(Model.Content.Replace("\n", "<br/>"))</p>
            </div>
            <div class="card-footer bg-white p-3">
                <a class="btn btn-outline-secondary" asp-action="Index">返回消息中心</a>
                <form asp-action="Delete" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button class="btn btn-outline-danger">删除</button>
                </form>
            </div>
        </div>
    </div>
</div>
